ETORO_API_KEY=XXX
ETORO_USER_KEY=your_agent_portfolio_user_token_here
SAFETY_CASH=20
MIN_POSITION_VALUE=40

# Database paths
# DB_PATH=data.sqlite
# PORTFOLIO_DB_PATH=portfolio.sqlite

# Rebalance interval (trading days, only affects bullish mode)
REBALANCE_INTERVAL_DAYS=20

# VIX panic threshold
VIX_THRESHOLD=32

# Bullish symbols (leveraged ETFs)
SYMBOL_SPY=SPY
SYMBOL_SPYU=SPYU
SYMBOL_UPRO=UPRO
SYMBOL_TECL=TECL
SYMBOL_TNA=TNA
SYMBOL_TQQQ=TQQQ
SYMBOL_UDOW=UDOW

# Panic symbols (safe havens)
SYMBOL_GOLD=GOLD
SYMBOL_TLT=TLT
SYMBOL_SHY=BIL

# Cash / bond parking
SYMBOL_CASH=BND
